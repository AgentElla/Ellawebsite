---
/**
 * The site's entire icon system: one component, one small hand-authored
 * registry, inlined as SVG. No icon package is installed — only 7 icons are
 * used anywhere on the page, so importing a full library (Lucide, Heroicons,
 * etc.) would ship far more than is ever rendered. Each icon here is built
 * from plain primitives (circle/line/polyline/rect) in Lucide's visual idiom
 * — simple geometric outline strokes — rather than reproducing Lucide's exact
 * bezier path data from memory, which risks a subtly malformed curve that
 * still parses but renders wrong. Primitives are easy to verify correct by
 * construction.
 *
 * Every icon is 24×24 viewBox, stroke-based, round caps/joins, no fill
 * (except the small solid target dot). Size and stroke weight are props, not
 * baked in, so the same glyph works at eyebrow scale (16–20px) or step scale
 * (24–32px) without a second asset.
 */

type IconName = 'search' | 'badge-check' | 'network' | 'message' | 'file-search' | 'target' | 'trending-up';

interface Props {
  name: IconName;
  /** Pixel size, applied to both width and height. */
  size?: number;
  strokeWidth?: number;
  class?: string;
  /**
   * True (default) for every icon on this site: each one sits beside or
   * above text that already states the same meaning (an eyebrow label, a
   * step title), so the icon is redundant to a screen reader and should not
   * be announced twice. Pass false only for an icon used with no adjacent
   * text label of its own.
   */
  decorative?: boolean;
  /** Accessible name, required when decorative={false}. */
  label?: string;
}

const { name, size = 20, strokeWidth = 1.75, class: className, decorative = true, label } = Astro.props;

// prettier-ignore
const paths: Record<IconName, string> = {
  // Magnifying glass. AI SEO / search-visibility content.
  'search': '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.2" y2="16.2"/>',
  // Circle + check. Verified authority — personal brand / founder presence content.
  'badge-check': '<circle cx="12" cy="12" r="9"/><polyline points="8,12.5 10.5,15 16,9"/>',
  // Three linked nodes. One connected practice, not three disconnected specialists.
  'network': '<circle cx="6" cy="7" r="2.2"/><circle cx="18" cy="7" r="2.2"/><circle cx="12" cy="18" r="2.2"/><line x1="8" y1="8.3" x2="10.3" y2="15.8"/><line x1="16" y1="8.3" x2="13.7" y2="15.8"/><line x1="8.2" y1="7" x2="15.8" y2="7"/>',
  // Speech bubble with a tail. A conversation — "a call, first."
  'message': '<rect x="3" y="5" width="18" height="12" rx="3"/><polyline points="8,17 8,20.5 12,17"/>',
  // Document + magnifier. Auditing what already exists.
  'file-search': '<rect x="4" y="3" width="12" height="16" rx="1.5"/><line x1="7" y1="8" x2="13" y2="8"/><line x1="7" y1="12" x2="11" y2="12"/><circle cx="17" cy="17" r="3.2"/><line x1="19.3" y1="19.3" x2="21.5" y2="21.5"/>',
  // Concentric rings + a solid centre. Strategy, a deliberate aim.
  'target': '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  // Rising zigzag with an arrowhead. Applying and compounding results.
  'trending-up': '<polyline points="3,17 9,10 13,13 21,4"/><polyline points="15,4 21,4 21,10"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  set:html={paths[name]}
/>
