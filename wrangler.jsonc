{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"name": "ella-siew-onepage",
	// Static build: no Worker entrypoint, Cloudflare serves ./dist directly.
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
	// Deploy verification commit 2: Git connection was set up after the first
	// push, so this retriggers a build now that it's active.
}
